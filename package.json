{
  "name": "gole",
  "version": "0.1.0",
  "private": true,
  "description": "GoLe - LEGO Marketplace monorepo",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "test:web": "pnpm --filter web test",
    "e2e:web": "pnpm --filter web e2e",
    "e2e:seed": "bash scripts/seed-e2e-accounts.sh",
    "dev:api": "node scripts/gradle.mjs --local bootRun",
    "build:api": "node scripts/gradle.mjs build",
    "test:api": "node scripts/gradle.mjs test",
    "infra:up": "docker compose up -d --wait mongo redis minio && docker compose run --rm --no-deps mongo-init",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait mongo redis minio && docker compose run --rm --no-deps mongo-init"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3"
}
