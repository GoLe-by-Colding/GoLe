[Unit]
Description=GoLe root-only GCP credential broker
After=network-online.target gole-metadata-firewall.service
Wants=network-online.target
Requires=gole-metadata-firewall.service
Before=gole-github-runner.service
Before=docker.service
OnFailure=poweroff.target
OnFailureJobMode=replace-irreversibly

[Service]
Type=simple
User=root
Group=golecloud
UMask=0007
RuntimeDirectory=gole-cloud-broker
RuntimeDirectoryMode=0710
RuntimeDirectoryPreserve=yes
StateDirectory=gole-cloud-broker
StateDirectoryMode=0700
ExecStart=/usr/local/libexec/gole/cloud-broker.py
ExecStartPost=/usr/local/libexec/gole/verify-cloud-broker-ready.sh
TimeoutStartSec=40s
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/gole-cloud-broker /var/lib/gole-cloud-broker
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
