[Unit]
Description=GoLe pre-snapshot logical data backup
After=docker.service
Requires=docker.service
OnFailure=gole-data-backup-failure.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/gole-backup-data
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
