[Unit]
# 재부팅이 남겨둔 운영 컨테이너를 다시 켠다.
#
# 컨테이너는 restart: unless-stopped 이지만, docker 가 "명시적으로 stop 됨"으로 기록한
# 컨테이너는 되살리지 않는다. 2026-09-11 에 unattended-upgrades 가 libc6 를 교체하며
# docker.service 를 재시작했을 때 컨테이너들이 그 상태로 남았고, 이후 어떤 부팅에서도
# 자동 기동되지 않아 8일간 서비스가 내려갔다.
Description=Start the GoLe production containers left stopped by a reboot
Documentation=https://github.com/GoLe-by-Colding/GoLe/pull/122
Requires=docker.service
After=docker.service
After=gole-metadata-firewall.service gole-cloud-broker.service
Wants=network-online.target
After=network-online.target

# 부트스트랩·배포가 끝난 호스트에서만 의미가 있다. 아니면 skip 된다(실패가 아니다).
ConditionPathExists=/etc/gole/host-bootstrap.complete
ConditionPathExists=/etc/gole/deployed.sha

# 아래 마커가 하나라도 있으면 "컨테이너가 일부러 멈춰 있다"는 뜻이다.
# 그 복구는 다음 CD 실행이나 사람이 할 일이지 부팅 유닛이 끼어들 자리가 아니다.
ConditionPathExists=!/etc/gole/deployment.transaction
ConditionPathExists=!/etc/gole/gole.env.transaction
ConditionPathExists=!/etc/gole/nginx.conf.transaction
ConditionPathExists=!/etc/gole/gole.adoption.transaction
ConditionPathExists=!/etc/gole/initial-deploy.pending
ConditionPathExists=!/var/backups/gole-data/MINIO_UNFREEZE_REQUIRED

# OnFailure 를 두지 않는다. gole-metadata-firewall · gole-cloud-broker ·
# gole-cost-guard-watchdog 은 실패 시 전원을 내리지만 이 유닛은 정반대다 —
# 스택이 안 떴다고 호스트까지 꺼버리면 2026-09-11 중단을 그 수정본이 재생산한다.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gole-stack-start
TimeoutStartSec=120s
# 부팅 복구가 데이터 평면과 IO 를 다투지 않게 한다.
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5

[Install]
WantedBy=multi-user.target
