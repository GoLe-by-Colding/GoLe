# GoLe production runner has no Docker or supplemental group membership. The
# dispatcher path alone is never authorized: sudo matches an exact no-argument
# command or a fully anchored POSIX ERE for every allowed argument vector.
User_Alias GOLE_DEPLOY = __DEPLOY_USER__

Cmnd_Alias GOLE_HOST_READ = \
  /usr/local/sbin/gole-hostctl privilege-probe "", \
  /usr/local/sbin/gole-hostctl deployment-read-sha "", \
  /usr/local/sbin/gole-hostctl deployment-is-uninitialized "", \
  /usr/local/sbin/gole-hostctl deployment-recover "", \
  /usr/local/sbin/gole-hostctl deployment-budget-healthy "", \
  /usr/local/sbin/gole-hostctl deployment-verify-runtime ^[0-9a-f]{40}$, \
  /usr/local/sbin/gole-hostctl watchdog-active ""

Cmnd_Alias GOLE_HOST_DEPLOY = \
  /usr/local/sbin/gole-hostctl deployment-begin ^(all|backend|frontend) [0-9a-f]{40} (0|[0-9a-f]{40}) [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$, \
  /usr/local/sbin/gole-hostctl deployment-images-snapshot ^(all|backend|frontend) [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$, \
  /usr/local/sbin/gole-hostctl deployment-compose-build ^(all|backend|frontend) [0-9a-f]{40} [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$, \
  /usr/local/sbin/gole-hostctl deployment-compose-up ^(rollout-all-apps|rollout-backend|rollout-frontend|rollout-budget|refresh-nginx) [0-9a-f]{40} [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$, \
  /usr/local/sbin/gole-hostctl deployment-compose-ps ^[0-9a-f]{40} [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$, \
  /usr/local/sbin/gole-hostctl deployment-verify-candidate-runtime ^[0-9a-f]{40} [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$, \
  /usr/local/sbin/gole-hostctl nginx-transaction-begin ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12} [0-9a-f]{40}$, \
  /usr/local/sbin/gole-hostctl nginx-transaction-commit ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$, \
  /usr/local/sbin/gole-hostctl deployment-record-sha ^[0-9a-f]{40} [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$, \
  /usr/local/sbin/gole-hostctl deployment-verify-commit ^[0-9a-f]{40} [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$, \
  /usr/local/sbin/gole-hostctl nginx-transaction-finalize ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$, \
  /usr/local/sbin/gole-hostctl deployment-finalize ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$, \
  /usr/local/sbin/gole-hostctl deployment-finalize-partial ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$, \
  /usr/local/sbin/gole-hostctl deployment-rollback ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$, \
  /usr/local/sbin/gole-hostctl deployment-fail-closed ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$, \
  /usr/local/sbin/gole-hostctl watchdog-install "", \
  /usr/local/sbin/gole-hostctl cost-guard-fail-closed ""

Cmnd_Alias GOLE_HOST_SECRET = \
  /usr/local/sbin/gole-hostctl discord-overlay-install "", \
  /usr/local/sbin/gole-hostctl discord-overlay-verify "", \
  /usr/local/sbin/gole-hostctl secret-sync ^[1-9][0-9]{0\,11} [0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$

Cmnd_Alias GOLE_HOST_CONTROL = GOLE_HOST_READ, GOLE_HOST_DEPLOY, GOLE_HOST_SECRET

# No runner-controlled environment crosses the privilege boundary. Compose
# interpolation is sourced only from root-owned 0600 files and then validated.
Defaults!GOLE_HOST_CONTROL env_reset

GOLE_DEPLOY ALL=(root) NOPASSWD: GOLE_HOST_CONTROL
