GOLE_ENVIRONMENT=local
GOLE_ONBOARDING_PHONE_REQUIRED=true
GOLE_ONBOARDING_LOG_VERIFICATION_CODES=true
GOLE_VERIFICATION_EMAIL_ENABLED=false
GOLE_MAIL_HEALTH_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=developer@example.test
SMTP_PASSWORD=example
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_STARTTLS_REQUIRED=false
SMTP_SSL_CHECKSERVERIDENTITY=false
GOLE_VERIFICATION_EMAIL_FROM=developer@example.test
GOLE_CATALOG_SEED=true
GOLE_LISTING_SEED=true
GOLE_PRICING_SEED=true
GOLE_PRICING_INCLUDE_DEMO=true
GOLE_PRICING_INCLUDE_LEGACY=true
GOLE_COMMUNITY_SEED=true
GOLE_REPORT_SEED=true
GOLE_REVIEW_SEED=true
GOLE_MEDIA_SEED=true
GOLE_SESSION_COOKIE_SECURE=auto
GOLE_WEB_ALLOWED_ORIGINS=http://localhost:3000
GOLE_OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback/google,http://localhost:3000/auth/callback/kakao,http://localhost:3000/auth/callback/naver
GOLE_TERMS_VERSION=2025-01-01
GOLE_PRIVACY_VERSION=2025-01-01
GOLE_SUPPORT_AGENT_ENABLED=false
GOLE_SUPPORT_AGENT_GRPC_TARGET=localhost:50051
GOLE_SUPPORT_AGENT_TIMEOUT=PT10S
PORTONE_ENABLED=false
NEXT_PUBLIC_PAYMENT_MODE=stub
GOLE_SETTLEMENT_MODE=DISABLED
GOLE_SETTLEMENT_PAYOUT_CONTRACT_VERIFIED=false
MONGODB_URI=mongodb://localhost:27017/gole
MONGODB_DATABASE=gole
REDIS_HOST=localhost
