resolver 127.0.0.11 valid=10s ipv6=off;

upstream gole_backend {
    zone gole_backend 64k;
    server backend:8080 resolve;
}

upstream gole_frontend {
    zone gole_frontend 64k;
    server frontend:3000 resolve;
}

server {
    listen 80;
    listen [::]:80;
    server_name www.__DOMAIN__;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://__DOMAIN__$request_uri; }
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    # 앱의 55MB multipart 제한이 사용자 오류를 판정하고 로그를 남긴다. Nginx의 64MB는
    # 무제한 요청으로 호스트 디스크가 소진되는 것만 막는 전송 안전 상한이다.
    client_max_body_size 64m;
    # 앱의 32KB 전체 헤더 한도보다 넉넉하게 열어 실제 거부와 로그는 백엔드가 담당한다.
    # 여기 값은 Nginx 기본 8KB가 앱보다 먼저 끊는 일을 막는 전송 계층 여유분이다.
    large_client_header_buffers 4 64k;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    location /api/ {
        proxy_pass http://gole_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location ~ ^/(actuator|v3/api-docs|swagger-ui) {
        proxy_pass http://gole_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://gole_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
