# Node / Next.js
node_modules/
.next/
# Next.js 정적 export 디렉토리 (web 앱으로 한정).
# 주의: 단순히 `out/`으로 두면 헥사고날의 adapter/out·application/port/out
# 소스 디렉토리까지 무시되어 영속성 어댑터가 커밋되지 않는다.
apps/web/out/
.turbo/
*.tsbuildinfo
next-env.d.ts
# 개인 환경변수. 예시 파일만 버전 관리한다.
.env
.env.*
!.env.example
!**/.env.example
playwright-report/
test-results/
blob-report/
.playwright/

# Java / Gradle
apps/api/.gradle/
apps/api/build/
apps/api/bin/
.gradle/
build/

# Python (GCP budget relay tests/runtime)
__pycache__/
*.py[cod]

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Terraform local state and provider cache
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Kiro 로컬 스펙 메타데이터(머신별 specId) — 추적하지 않는다
.kiro/specs/**/.config.kiro

# 에이전트 가이드 — 저장소는 도구 중립으로 두고 로컬 전용으로만 쓴다.
# AGENTS.md 가 정본이고, CLAUDE.md 는 그것을 @import 하는 도구별 진입 파일이다.
# 둘 다 추적하지 않으므로 새로 클론하면 직접 만들어야 한다:
#   printf '@AGENTS.md\n' > CLAUDE.md
AGENTS.md
CLAUDE.md

# Claude Code 프로젝트 설정 — 위와 같은 이유로 로컬 전용이다.
# .claude/settings.local.json 에 검증 명령 허용목록이 들어 있다(승인 클릭 줄이기용).
.claude/
