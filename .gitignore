# Node / Next.js
node_modules/
.next/
# Next.js 정적 export 디렉토리 (web 앱으로 한정).
# 주의: 단순히 `out/`으로 두면 헥사고날의 adapter/out·application/port/out
# 소스 디렉토리까지 무시되어 영속성 어댑터가 커밋되지 않는다.
apps/web/out/
.turbo/
*.tsbuildinfo
next-env.d.ts
# 개인 환경변수. 예시 파일만 버전 관리한다.
.env
.env.*
apps/support-agent/generated/
!.env.example
!**/.env.example
playwright-report/
test-results/
blob-report/
.playwright/

# Java / Gradle
apps/api/.gradle/
apps/api/build/
apps/api/bin/
.gradle/
build/

# Python (GCP budget relay tests/runtime)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Terraform local state and provider cache
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
crash.*.log
.terraform.lock.hcl
!infra/gcp/terraform/.terraform.lock.hcl

# Kiro 로컬 스펙 메타데이터(머신별 specId) — 추적하지 않는다
.kiro/specs/**/.config.kiro

# 에이전트 가이드·하네스는 추적한다.
# 정본(AGENTS.md)과 집행자(.claude/hooks)가 저장소 밖에 있으면, 클론·CI·새 세션에서
# 규칙이 사라진다. 실제로 그렇게 깨졌다 — 훅 스크립트가 따라가지 못해 매 Bash 호출마다
# exit 127 이 났고, 저장소만 본 에이전트는 .kiro 의 낡은 커밋 규칙을 따랐다.
#
# 추적: AGENTS.md · CLAUDE.md · .claude/hooks/ · .claude/settings.json
# 무시: 개인·머신별 설정과 런타임 산출물 (아래)
.claude/*
!.claude/hooks/
!.claude/settings.json
.claude/settings.local.json
.claude/.agent-dev-servers
.claude/.agent-devlog-pending

# FCM 발송용 서비스 계정 키. 이것만 있으면 누구나 이 앱 사용자 전원에게 푸시를 보낼 수 있다.
# .env 와 달리 확장자가 .json 이라 일반 패턴에 걸리지 않으므로 명시적으로 막는다.
gole-fcm-service-account.json
*-service-account.json

# APNs 인증키. 팀 전체의 푸시를 보낼 수 있고 발급 시 한 번만 내려받을 수 있다.
# apps/mobile/.gitignore 에도 있지만 루트에 받아둘 수 있으므로 여기서도 막는다.
*.p8
*.p12
*.mobileprovision

# 옵시디언 — 팀 문서 볼트는 별도 저장소 GoLe-obsidian 으로 분리했다.
# 이 저장소를 볼트로 여는 것은 개인 선택이므로 설정 전체를 각자 것으로 둔다.
.obsidian/
