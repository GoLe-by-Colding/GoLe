# Node / Next.js
node_modules/
.next/
# Next.js 정적 export 디렉토리 (web 앱으로 한정).
# 주의: 단순히 `out/`으로 두면 헥사고날의 adapter/out·application/port/out
# 소스 디렉토리까지 무시되어 영속성 어댑터가 커밋되지 않는다.
apps/web/out/
.turbo/
*.tsbuildinfo
next-env.d.ts
# 개인 환경변수. 예시 파일만 버전 관리한다.
.env
.env.*
apps/support-agent/generated/
!.env.example
!**/.env.example
playwright-report/
test-results/
blob-report/
.playwright/

# Java / Gradle
apps/api/.gradle/
apps/api/build/
apps/api/bin/
.gradle/
build/

# Python (GCP budget relay tests/runtime)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Terraform local state and provider cache
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
crash.*.log
.terraform.lock.hcl
!infra/gcp/terraform/.terraform.lock.hcl

# Kiro 로컬 스펙 메타데이터(머신별 specId) — 추적하지 않는다
.kiro/specs/**/.config.kiro

# 에이전트 가이드 — 저장소는 도구 중립으로 두고 로컬 전용으로만 쓴다.
# AGENTS.md 가 정본이고, CLAUDE.md 는 그것을 @import 하는 도구별 진입 파일이다.
# 둘 다 추적하지 않으므로 새로 클론하면 직접 만들어야 한다:
#   printf '@AGENTS.md\n' > CLAUDE.md
AGENTS.md
CLAUDE.md

# Claude Code 프로젝트 설정 — 위와 같은 이유로 로컬 전용이다.
# .claude/settings.local.json 에 검증 명령 허용목록이 들어 있다(승인 클릭 줄이기용).
.claude/

# FCM 발송용 서비스 계정 키. 이것만 있으면 누구나 이 앱 사용자 전원에게 푸시를 보낼 수 있다.
# .env 와 달리 확장자가 .json 이라 일반 패턴에 걸리지 않으므로 명시적으로 막는다.
gole-fcm-service-account.json
*-service-account.json

# APNs 인증키. 팀 전체의 푸시를 보낼 수 있고 발급 시 한 번만 내려받을 수 있다.
# apps/mobile/.gitignore 에도 있지만 루트에 받아둘 수 있으므로 여기서도 막는다.
*.p8
*.p12
*.mobileprovision

# 옵시디언 — 저장소 루트가 볼트다(docs/index.md 참고).
# 설정과 그래프 색상은 공유하고, 개인 UI 상태·캐시·설치한 플러그인은 각자 것으로 둔다.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/
.obsidian/themes/
.obsidian/hotkeys.json
.obsidian/snippets/
