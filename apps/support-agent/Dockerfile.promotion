# 홍보 에이전트 전용 이미지(스펙 D10).
#
# 운영에 상주하는 support-agent 이미지(apps/support-agent/Dockerfile, mem_limit 192m)와
# 일부러 분리한다. 브라우저를 넣으면 이미지가 수백 MB 커지는데, 그 비용을 하루 한 번 떴다
# 지는 컨테이너만 지불하고 상시 서비스는 그대로 두기 위해서다.
FROM python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

# git 은 릴리스 이력을 읽는 데 쓴다. 저장소 자체는 이미지에 굽지 않고 read-only 로 마운트한다.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv==0.10.2
COPY apps/support-agent/pyproject.toml apps/support-agent/uv.lock ./
RUN uv sync --locked --no-dev --extra promotion
RUN uv run --no-sync playwright install --with-deps chromium

COPY apps/support-agent/src ./src
ENV PYTHONPATH="/app/src"

RUN useradd --system --uid 10003 --create-home promotion-agent \
    && chown -R promotion-agent:promotion-agent /app /ms-playwright

# 상태 경로를 이미지에 미리 만들어 둔다. Compose 가 여기에 named volume 을 거는데,
# 이미지에 없는 경로에 빈 볼륨을 마운트하면 Docker 가 root:root 0755 로 만든다.
# 컨테이너는 uid 10003 으로 돌기 때문에 세션·체크포인트·manifest 쓰기가 전부 EACCES 가 된다.
# 미리 있으면 Docker 가 이 디렉터리의 소유자·권한을 새 볼륨에 그대로 복사한다.
RUN install -d -o promotion-agent -g promotion-agent /var/lib/gole/promotion-agent

USER promotion-agent

# oneshot 이라 HEALTHCHECK 를 두지 않는다 — 살아 있는 것이 정상인 프로세스가 아니다.
HEALTHCHECK NONE
ENTRYPOINT ["python", "-m", "gole_promotion_agent"]
