# 홍보 초안 실행(gole_promotion_agent.cli_runner) 전용 환경 변수.
#
# 운영 실행은 .github/workflows/promotion-agent.yml 이 self-hosted 서버(라벨 gole-promotion)에서
# 넣는다. 모델은 API 키가 아니라 그 서버에 로그인된 Claude Code(`claude`)를 쓴다.
# 로컬에서 시험할 때만 이 값을 셸에 export 한다. 실제 자격증명을 이 예시 파일이나 저장소에 넣지 않는다.

# --- 모델 ---
# 기본은 `claude` 로그인(구독)이다. ANTHROPIC_API_KEY 가 있으면 claude 가 그 키를 쓴다.
# PROMOTION_AGENT_MODEL — 선택. claude --model 로 넘긴다(예: sonnet, opus). 비우면 claude 기본값.
# PROMOTION_AGENT_CLAUDE_BIN — 선택. claude 실행 파일 경로. 비우면 PATH 의 claude.
# ANTHROPIC_API_KEY=
# PROMOTION_AGENT_MODEL=
# PROMOTION_AGENT_CLAUDE_BIN=

# --- 찍는 곳: 데모 스택 ---
# PROMOTION_AGENT_CAPTURE_SITE — 캡처할 웹(예: http://localhost:3000).
# PROMOTION_AGENT_CAPTURE_API_URL — 그 웹의 API. 촬영용 로그인에 쓴다(예: http://localhost:8080).
# PROMOTION_AGENT_CAPTURE_ADMIN_* — 데모 스택 관리자. e2e 시더 계정이면 시크릿이 아니다.
# PROMOTION_AGENT_DATA_SOURCE — DEMO(기본) 면 시세 화면 촬영을 막는다.
# PROMOTION_AGENT_CAPTURE_SITE=
# PROMOTION_AGENT_CAPTURE_API_URL=
# PROMOTION_AGENT_CAPTURE_ADMIN_EMAIL=
# PROMOTION_AGENT_CAPTURE_ADMIN_PASSWORD=
# PROMOTION_AGENT_DATA_SOURCE=DEMO

# --- 내는 곳: 검토 큐 ---
# 초안 생성·제출 전용 ADMIN 계정. 메이커-체커(D4) 때문에 검토는 반드시 다른 사람 ADMIN
# 계정으로 한다 — 이 계정은 자기가 만든 초안을 승인할 수 없다. 이 값은 claude 프로세스로
# 넘어가지 않는다(cli_runner.PASSTHROUGH_ENV).
# PROMOTION_AGENT_API_URL=
# PROMOTION_AGENT_ADMIN_EMAIL=
# PROMOTION_AGENT_ADMIN_PASSWORD=
# PROMOTION_AGENT_RUN_URL=
