# 홍보 초안 실행(python -m gole_promotion_agent) 전용 환경 변수.
#
# 운영 실행은 .github/workflows/promotion-agent.yml 이 GitHub 러너에서 넣는다. 러너는 주문서만 SSH 로 지인 서버에
# 넣고 끝나며, 기획·제작(codex)과 검토 큐 납품은 지인 서버가 한다(promotion-review D29).
# 로컬에서 시험할 때만 이 값을 셸에 export 한다. 실제 자격증명을 이 예시 파일이나 저장소에 넣지 않는다.

# --- 게이트웨이 ---
# PROMOTION_GATEWAY=local 이면 SSH 없이 이 기기의 codex 로 지인 서버의 처리(deliver)를 이 프로세스에서 돈다
# (개발·시험용). 결과는 PROMOTION_AGENT_API_URL 의 납품 창구로 PROMOTION_AGENT_TOKEN 을 써서 보낸다 — 그 API 는
# PROMOTION_AGENT_TOKEN_SHA256 에 이 토큰의 SHA-256 을 갖고 떠 있어야 한다.
# 아니면 SSH: TARGET 은 user@host, KNOWN_HOSTS_FILE 은 서버 호스트 키(ssh-keyscan 결과).
# 인증은 KEY_FILE(forced command 로 run.sh 만 여는 전용 키) 하나다. 처음 보는 호스트에는 붙지 않는다.
# PROMOTION_AGENT_TOKEN=
# PROMOTION_GATEWAY=
# PROMOTION_GATEWAY_TARGET=
# PROMOTION_GATEWAY_PORT=22
# PROMOTION_GATEWAY_KEY_FILE=
# PROMOTION_GATEWAY_KNOWN_HOSTS_FILE=
# 선택. 비우면 codex CLI 기본 모델.
# PROMOTION_AGENT_CODEX_MODEL=

# --- 찍는 곳: 데모 스택 ---
# PROMOTION_AGENT_CAPTURE_SITE — 캡처할 웹(예: http://localhost:3000).
# PROMOTION_AGENT_CAPTURE_API_URL — 그 웹의 API. 촬영용 로그인에 쓴다(예: http://localhost:8080).
# PROMOTION_AGENT_CAPTURE_ADMIN_* — 데모 스택 관리자. e2e 시더 계정이면 시크릿이 아니다.
# PROMOTION_AGENT_DATA_SOURCE — DEMO(기본) 면 시세 화면 촬영을 막는다.
# PROMOTION_AGENT_CAPTURE_SITE=
# PROMOTION_AGENT_CAPTURE_API_URL=
# PROMOTION_AGENT_CAPTURE_ADMIN_EMAIL=
# PROMOTION_AGENT_CAPTURE_ADMIN_PASSWORD=
# PROMOTION_AGENT_DATA_SOURCE=DEMO

# --- 내는 곳: 검토 큐 ---
# 홍보 봇 ADMIN 계정. 러너는 큐 상태·작업 기억·이력을 읽고 실행 전 원장만 남긴다. 메이커-체커(D4) 때문에 검토는
# 반드시 다른 사람 ADMIN 계정으로 한다. 이 값은 지인 서버로 가지 않는다 — 서버는 납품 창구만 여는 홍보 토큰을 쓴다.
# PROMOTION_AGENT_API_URL=
# PROMOTION_AGENT_ADMIN_EMAIL=
# PROMOTION_AGENT_ADMIN_PASSWORD=
# PROMOTION_AGENT_RUN_URL=
