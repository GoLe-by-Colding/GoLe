# 필요할 때 `.env.development.local`로 복사해 개인 개발 주소를 덮어쓴다.
# 기본 포트를 사용한다면 이 파일을 복사하지 않아도 된다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 선택적 이용 분석(GA4/GTM) ---
# 비우면 동의 UI·브라우저 저장소 접근·Google 스크립트/요청이 모두 비활성화된다.
# 값을 넣으면 사용자가 화면에서 명시적으로 허용한 뒤에만 Google 스크립트를 내려받는다.
# 두 값을 함께 넣어도 GTM만 로드한다. GTM 컨테이너 운영 계약은 docs/operations/analytics-consent.md.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# 실제 PortOne 결제를 테스트할 때만 설정한다. 공개 가능한 클라이언트 키만 둔다.
# API Secret·웹훅 시크릿은 절대 NEXT_PUBLIC_ 으로 두지 않는다 — 번들에 박혀 누구나 볼 수 있다.
#
# PAYMENT_MODE 를 빼면 개발 환경에서 stub 으로 떨어져 결제창이 뜨지 않는다.
# 그 상태에서 백엔드만 실연동이면 서버가 포트원 원장을 조회했을 때 결제 건이 없어
# 주문이 "결제 대기"에 머문다. 세 값을 함께 채워야 한다.
#
# NEXT_PUBLIC_* 은 next build 시점에 번들로 인라인된다. 파일만 고치고 dev 서버를 그대로
# 두면 브라우저는 이전 값을 계속 쓴다 — 반드시 재시작(배포는 재빌드)해야 한다.
# 사용자 모집 단계에서는 disabled, 실제 테스트 결제창을 확인할 때만 portone-test로 바꾼다.
# NEXT_PUBLIC_PAYMENT_MODE=disabled
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# 카드 채널(선택). 채우면 주문 화면에 "카카오페이 / 신용·체크카드" 선택이 나타나고,
# 비우면 선택 UI 없이 카카오페이로만 결제한다.
# 루트 .env 의 PORTONE_CARD_CHANNEL_KEY 와 같아야 한다 — 서버가 원장의 채널 키로
# 결제수단을 판정하므로 값이 다르면 카드 결제가 전부 수동 검토로 떨어진다.
NEXT_PUBLIC_PORTONE_CARD_CHANNEL_KEY=

# --- E2E(Playwright) 전용 ---
# 평소에는 비운다. `pnpm test:e2e` 가 로컬 프론트를 직접 띄우고 결제는 stub 으로 고정한다.
#
# E2E_BASE_URL — 이미 떠 있는 배포본을 대상으로 돌린다. 설정하면 쓰기가 발생하는
#   시나리오(구매·상품등록)와 응답 가로채기 기반 시나리오는 자동으로 skip 된다.
# E2E_WITH_BACKEND — 백엔드까지 함께 검증하는 관리자 콘솔 테스트를 켠다. 없으면 skip 된다.
# GOLE_ADMIN_EMAIL / GOLE_ADMIN_PASSWORD — 관리자 콘솔 테스트의 로그인 자격증명.
#   루트 .env 에 넣어 API가 그 계정을 시드하게 한 값과 같아야 한다. 비어 있으면 로그인이
#   실패해 테스트가 무의미하게 통과·실패한다.
# E2E_BASE_URL=
# E2E_WITH_BACKEND=
# GOLE_ADMIN_EMAIL=
# GOLE_ADMIN_PASSWORD=

# --- 홍보 초안 자동화 에이전트(promotion-agent) 전용 ---
# 평소에는 비운다. GitHub Actions(.github/workflows/promotion-agent.yml)에서는 secrets로
# 주입되고, 로컬에서 `pnpm --filter web promotion-agent`로 직접 돌려볼 때만 필요하다.
#
# PROMOTION_AGENT_ADMIN_EMAIL / PROMOTION_AGENT_ADMIN_PASSWORD — 초안 생성·제출에 쓸 기존
#   관리자 계정(D14). 봇 전용 계정이 아니라 실제 ADMIN 권한 계정이어야 하고, 메이커-체커(D4)
#   때문에 이 계정으로는 자기가 만든 초안을 승인할 수 없다 — 검토는 반드시 다른 관리자
#   계정으로 한다(관리자가 1명뿐이면 검토가 영구히 막힌다).
# ANTHROPIC_API_KEY — 캡션 생성(Anthropic Messages API 직접 호출). 없으면 즉시 실패한다.
# ANTHROPIC_MODEL — 선택. 비우면 claude-sonnet-4-6.
# PROMOTION_AGENT_BASE_URL — 선택. 비우면 https://gole.co.kr(운영)을 직접 조작한다 — 로컬에서
#   무심코 돌리면 실제 운영 화면을 캡처하고 실제 관리자 계정으로 로그인하니 주의.
# PROMOTION_AGENT_LOOKBACK_HOURS — 선택. 24~27 사이 정수, 비우면 27.
# PROMOTION_AGENT_OUTPUT_DIR — 선택. 스크린샷 저장 경로, 비우면 ./promotion-agent-output.
# PROMOTION_AGENT_ADMIN_EMAIL=
# PROMOTION_AGENT_ADMIN_PASSWORD=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# PROMOTION_AGENT_BASE_URL=
# PROMOTION_AGENT_LOOKBACK_HOURS=
# PROMOTION_AGENT_OUTPUT_DIR=
