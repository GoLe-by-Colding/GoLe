# 앱 환경설정. `.env.local`로 복사해 쓴다(gitignore 대상).
#
# EXPO_PUBLIC_* 은 웹의 NEXT_PUBLIC_* 과 같이 빌드 시점에 번들로 인라인된다 —
# 값을 바꾸면 반드시 재빌드해야 한다. 시크릿은 절대 여기 두지 않는다.

# 비우면 개발 기본값을 쓴다: iOS는 http://localhost:8080,
# Android 에뮬레이터는 http://10.0.2.2:8080 (에뮬레이터의 localhost는 자기 자신이다).
# EXPO_PUBLIC_API_BASE_URL=

# 모바일 본문은 이 웹 원점을 WebView로 연다. 비우면 개발 :3000 / 배포 https://gole.co.kr.
# 실기기는 개발 머신 LAN IP를 지정한다. 공개 값만 허용하며 API 키를 넣지 않는다.
# EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000
